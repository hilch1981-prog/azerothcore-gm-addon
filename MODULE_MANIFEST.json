{
  "schema_version": 1,
  "purpose": "Minimal-context map for feature-scoped maintenance of AzerothAdmin.",
  "shared_context": [
    "AGENTS.md",
    "DEVELOPMENT_RULES.md",
    "AzerothAdmin/Framework/Bootstrap.lua",
    "AzerothAdmin/Framework/ModuleRegistry.lua",
    "AzerothAdmin/Framework/Localization.lua",
    "AzerothAdmin/Framework/UILocalization.lua",
    "AzerothAdmin/Framework/FeatureLocalization.lua",
    "AzerothAdmin/AzerothAdmin.toc"
  ],
  "rules": {
    "one_feature_per_pr": true,
    "preserve_existing_behavior_during_move": true,
    "read_data_files_only_when_data_changes": true,
    "locales_required": ["enUS", "koKR", "zhCN", "zhTW"],
    "default_locale": "enUS",
    "locale_selection": "automatic-with-manual-override",
    "runtime_ui_fallback": "enUS",
    "preserve_kokr_search_and_parser_data": true
  },
  "ignore_by_default": [
    "AzerothAdmin/KoKRSearchData.lua",
    "AzerothAdmin/Teleports.lua",
    "AzerothAdmin/Modules/Creatures/Data.lua",
    "AzerothAdmin/Modules/Creatures/ExpandedData.lua",
    "AzerothAdmin/Embedded/BlueItemInfo3/Data.lua",
