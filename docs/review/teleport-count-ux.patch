# Teleport 제목/전체 좌표 개수 UX 최소 변경 패치
# 대상: AzerothAdmin/Modules/Shell/UI.lua + Locales/UI/Features/*.lua
# 기준: main
# 목적: 제목의 하드코딩된 1,761 좌표 제거 + 실제 Teleports 데이터 개수 동적 표시
# 주의: Shell/UI.lua는 PR #57과 동일 파일이므로 현재는 런타임 미적용 검토용 패치만 유지.

--- a/AzerothAdmin/Modules/Shell/UI.lua
+++ b/AzerothAdmin/Modules/Shell/UI.lua
@@
-    local title = makeText(frame, "한글 순간이동 목록 · 1,761 좌표", "large")
+    local title = makeText(frame, "순간이동 목록", "large")
     title:SetPoint("TOPLEFT", frame, "TOPLEFT", 56, -18)
     title:SetTextColor(1, 0.78, 0.25)
+    local totalLabel = makeText(frame, "전체 좌표", "small")
+    totalLabel:SetPoint("TOPRIGHT", frame, "TOPRIGHT", -58, -18)
+    totalLabel:SetTextColor(0.62, 0.72, 0.78)
+    local totalCount = makeText(frame, tostring(table.getn(self.Teleports or {})), "small")
+    totalCount:SetPoint("LEFT", totalLabel, "RIGHT", 6, 0)
+    totalCount:SetTextColor(0.45, 0.90, 1.00)
+    self.teleportTotalCountText = totalCount
@@
 function addon:RefreshTeleportList()
     if not self.teleportButtons then return end
+    if self.teleportTotalCountText then
+        self.teleportTotalCountText:SetText(tostring(table.getn(self.Teleports or {})))
+    end
     local query = ""
@@
     self.teleportPageText:SetText("검색 " .. count .. "개   ·   " .. self.teleportPage .. " / " .. self.teleportPageCount)

